{
  "service": {
    "name": "resumeforge-builder",
    "namespace": "sarathi1010-alfo",
    "version": "1.4.0",
    "environment": "production",
    "domain": "https://resumeforge.alfo.online"
  },
  "open_telemetry": {
    "enabled": true,
    "exporter": {
      "type": "otlp-http",
      "endpoint": "https://telemetry.alfo.online/v1/traces",
      "protocol": "http/protobuf"
    },
    "metrics": {
      "endpoint": "https://telemetry.alfo.online/v1/metrics",
      "interval_ms": 30000,
      "tracked_metrics": [
        "resume_download_pdf_total",
        "ats_keyword_match_score",
        "template_switch_count",
        "preview_render_latency_ms",
        "core_web_vitals_lcp_ms",
        "core_web_vitals_cls",
        "core_web_vitals_inp_ms"
      ]
    },
    "tracing": {
      "sampling_rate": 1.0,
      "span_attributes": {
        "app.framework": "Next.js 14/15 App Router",
        "app.feature": "AI Resume Builder & ATS Scanner",
        "app.tier": "Tier-1 Autonomous SEO Web Utility"
      }
    }
  },
  "audit": {
    "last_audited": "2026-09-30T13:12:00Z",
    "auditor": "Alfo Autonomous Orchestrator",
    "seo_health_score": 98,
    "cwv_status": "PASS",
    "checks": {
      "canonical_urls": "VERIFIED",
      "sitemap_xml": "200 OK (Clean route mapping)",
      "json_ld_schema": "WebApplication + FAQPage + BreadcrumbList valid",
      "broken_links_404": 0,
      "mobile_responsive_score": 100,
      "indexation_status": "Google Indexing API Triggered"
    }
  },
  "evaluation": {
    "aeo_geo_readiness_score": 96,
    "ai_engine_optimization": {
      "structured_data_richness": "HIGH",
      "machine_parseable_tables": true,
      "direct_qa_block_present": true,
      "citation_worthiness": "OPTIMAL"
    },
    "performance_benchmarks": {
      "target_lcp_seconds": 1.2,
      "target_cls": 0.01,
      "target_inp_ms": 48
    },
    "next_quarter_goals": [
      "ATS keyword auto-matcher via client side NLP",
      "Export multi-format JSON resume / LaTeX",
      "Real-time live multi-color template customizer"
    ]
  },
  "eval_harness": {
    "framework": "promptfoo",
    "version": "0.98.0",
    "suites": [
      {
        "name": "ats_keyword_extraction_eval",
        "type": "llm_eval",
        "description": "Evaluates resume ATS parsing and keyword extraction fidelity",
        "metrics": [
          "precision",
          "recall",
          "f1_score",
          "latency_ms"
        ],
        "thresholds": {
          "min_f1_score": 0.92,
          "max_latency_ms": 800
        },
        "test_cases_path": "tests/evals/ats_benchmarks.json"
      },
      {
        "name": "seo_aeo_citation_eval",
        "type": "search_engine_eval",
        "description": "Measures Perplexity, Gemini, and Claude Answer Engine citation readiness",
        "metrics": [
          "citation_density",
          "groundedness",
          "structured_data_compliance"
        ],
        "thresholds": {
          "min_groundedness": 0.95,
          "min_citation_density": 0.85
        }
      }
    ],
    "ci_cd": {
      "run_on_pull_request": true,
      "block_on_failure": true,
      "report_format": [
        "json",
        "markdown"
      ]
    }
  }
}